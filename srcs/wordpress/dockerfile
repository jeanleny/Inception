FROM debian:bookworm

# Install everything WordPress + PHP-FPM needs
# php8.2-fpm        → the PHP-FPM process manager itself
# php8.2-mysql      → lets PHP talk to MySQL/MariaDB databases
# php8.2-curl       → WordPress uses curl to check for updates, call APIs
# php8.2-gd         → image processing (thumbnails, uploads)
# php8.2-mbstring   → handles multibyte characters (non-english text)
# php8.2-xml        → XML parsing, needed by many WordPress plugins
# php8.2-zip        → installing/updating plugins and themes
# mariadb-client    → gives us mysqladmin for the "wait for db" check
# curl              → needed to download WP-CLI
RUN apt-get update && apt-get install -y \
    php8.2-fpm \
    php8.2-mysql \
    php8.2-curl \
    php8.2-gd \
    php8.2-mbstring \
    php8.2-xml \
    php8.2-zip \
    mariadb-client \
    netcat-openbsd \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x wp-cli.phar \
    && mv wp-cli.phar /usr/local/bin/wp

RUN mkdir -p /var/www/html

COPY www.conf /etc/php/8.2/fpm/pool.d/www.conf

COPY entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/entrypoint.sh"]

CMD ["php-fpm8.2", "-F"]
